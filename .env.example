# Monte Carlo service — all optional
MC_WORKERS=2          # jobs running in parallel
MC_N_JOBS=1           # processes per simulation run (-1 = all cores)
MC_MAX_BODY_MB=100    # request size limit, compressed and decompressed
MC_JOB_TTL_S=604800   # finished jobs kept (seconds, default 7 days)
MC_JOB_DIR=/data/jobs # finished jobs saved here so they survive restarts (Docker volume)
MC_RERUN_TTL_S=3600   # a fleet job's records kept in memory for what-if re-runs
